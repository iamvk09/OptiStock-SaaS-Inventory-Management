# Database
# Connect to your Supabase or local PostgreSQL database
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Auth
# Generate a secure random string for JWT_SECRET (e.g., `openssl rand -base64 32`)
JWT_SECRET="super_secret_jwt_key_change_me"
JWT_EXPIRES_IN="7d"

# Stripe (Optional for local dev, required for billing)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_PRO="price_..."

# Email (Optional)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="password"
FROM_EMAIL="noreply@saasinventory.com"

# Frontend Configuration
VITE_API_URL="http://localhost:3000/api"

# Supabase (Required for Auth, Storage, DB)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key" # Required for Storage/Admin
SUPABASE_STORAGE_BUCKET="products"

# Email (Resend)
RESEND_API_KEY="re_..."

# Monitoring (Sentry)
SENTRY_DSN="https://...@sentry.io/..."
VITE_SENTRY_DSN="https://...@sentry.io/..."
