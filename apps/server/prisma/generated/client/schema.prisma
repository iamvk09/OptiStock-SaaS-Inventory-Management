generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  OWNER
  ADMIN
  STAFF
  READ_ONLY
}

enum TransactionType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

enum OrderStatus {
  DRAFT
  PENDING
  APPROVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum SalesStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  FAILED
  REFUNDED
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

// Core Models
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  name          String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  organizations     UserOrganizationRole[]
  audit_logs        AuditLog[]
  dashboard_configs UserDashboardConfig[]
  po_comments       POComment[]
}

model Organization {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  stripe_customer_id  String?
  subscription_status String? // active, past_due, canceled, etc.
  plan_tier           PlanTier @default(FREE)
  max_warehouses      Int      @default(1)
  max_users           Int      @default(2)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  users                 UserOrganizationRole[]
  products              Product[]
  warehouses            Warehouse[]
  suppliers             Supplier[]
  customers             Customer[]
  purchase_orders       PurchaseOrder[]
  sales_orders          SalesOrder[]
  stock_transactions    StockTransaction[]
  api_keys              ApiKey[]
  audit_logs            AuditLog[]
  dashboard_configs     UserDashboardConfig[]
  reservations          StockReservation[]
  bundles               ProductBundle[]
  feature_flags         FeatureFlag[]
  custom_fields         CustomField[]
  automation_rules      AutomationRule[]
  inventory_audits      InventoryAudit[]
  integration_configs   IntegrationConfig[]
  webhook_subscriptions WebhookSubscription[]
}

model UserOrganizationRole {
  id              String   @id @default(uuid())
  user_id         String
  organization_id String
  role            Role     @default(STAFF)
  created_at      DateTime @default(now())

  user         User         @relation(fields: [user_id], references: [id])
  organization Organization @relation(fields: [organization_id], references: [id])

  @@unique([user_id, organization_id])
}

// Product Management
model Product {
  id              String   @id @default(uuid())
  organization_id String
  name            String
  description     String?
  category        String?
  brand           String?
  hsn_code        String?
  tags            String[]
  image_url       String?
  is_archived     Boolean  @default(false)
  health_score    Int      @default(100)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization     @relation(fields: [organization_id], references: [id])
  variants     ProductVariant[]
}

model ProductVariant {
  id                  String   @id @default(uuid())
  product_id          String
  sku                 String
  barcode             String?
  price               Decimal  @default(0)
  cost_price          Decimal  @default(0)
  attributes          Json? // { "color": "red", "size": "L" }
  images              String[]
  low_stock_threshold Int      @default(10)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  product        Product             @relation(fields: [product_id], references: [id])
  stock_levels   StockLevel[]
  purchase_items PurchaseItem[]
  sales_items    SalesItem[]
  reservations   StockReservation[]
  bundle_items   ProductBundleItem[]
  AuditItem      AuditItem[]
}

model ProductBundle {
  id              String   @id @default(uuid())
  organization_id String
  name            String
  sku             String   @unique
  description     String?
  price           Decimal
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization        @relation(fields: [organization_id], references: [id])
  items        ProductBundleItem[]
}

model ProductBundleItem {
  id                 String @id @default(uuid())
  bundle_id          String
  product_variant_id String
  quantity           Int

  bundle  ProductBundle  @relation(fields: [bundle_id], references: [id])
  variant ProductVariant @relation(fields: [product_variant_id], references: [id])
}

// Inventory
model Warehouse {
  id              String   @id @default(uuid())
  organization_id String
  name            String
  location        String?
  capacity        Int? // Max units
  utilization     Float? // Calculated percentage
  is_frozen       Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization     Organization       @relation(fields: [organization_id], references: [id])
  stock_levels     StockLevel[]
  reservations     StockReservation[]
  from_transfers   StockTransaction[] @relation("FromWarehouse")
  to_transfers     StockTransaction[] @relation("ToWarehouse")
  locations        Location[]
  inventory_audits InventoryAudit[]
}

model StockReservation {
  id                 String    @id @default(uuid())
  organization_id    String
  warehouse_id       String
  product_variant_id String
  quantity           Int
  status             String    @default("ACTIVE") // ACTIVE, FULFILLED, EXPIRED
  expires_at         DateTime?
  reference_id       String?
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  organization Organization   @relation(fields: [organization_id], references: [id])
  warehouse    Warehouse      @relation(fields: [warehouse_id], references: [id])
  variant      ProductVariant @relation(fields: [product_variant_id], references: [id])
}

model StockLevel {
  id                 String    @id @default(uuid())
  warehouse_id       String
  product_variant_id String
  quantity           Int       @default(0)
  batch_number       String?
  expiry_date        DateTime?
  location_code      String? // Aisle-Rack-Shelf-Bin
  updated_at         DateTime  @updatedAt

  warehouse Warehouse      @relation(fields: [warehouse_id], references: [id])
  variant   ProductVariant @relation(fields: [product_variant_id], references: [id])

  @@unique([warehouse_id, product_variant_id, batch_number])
}

model StockTransaction {
  id                 String          @id @default(uuid())
  organization_id    String
  type               TransactionType
  quantity           Int
  previous_quantity  Int?
  new_quantity       Int?
  product_variant_id String

  from_warehouse_id String?
  to_warehouse_id   String?

  reference_id String? // PO ID, SO ID, etc.
  notes        String?
  created_at   DateTime @default(now())
  created_by   String? // User ID

  organization   Organization @relation(fields: [organization_id], references: [id])
  from_warehouse Warehouse?   @relation("FromWarehouse", fields: [from_warehouse_id], references: [id])
  to_warehouse   Warehouse?   @relation("ToWarehouse", fields: [to_warehouse_id], references: [id])
}

// Procurement
model Supplier {
  id                    String   @id @default(uuid())
  organization_id       String
  name                  String
  email                 String?
  phone                 String?
  address               String?
  rating                Float?
  average_delivery_time Int? // Days
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  organization    Organization    @relation(fields: [organization_id], references: [id])
  purchase_orders PurchaseOrder[]
}

model PurchaseOrder {
  id              String      @id @default(uuid())
  organization_id String
  supplier_id     String
  status          OrderStatus @default(DRAFT)
  order_date      DateTime    @default(now())
  expected_date   DateTime?
  delivery_date   DateTime?
  total_amount    Decimal     @default(0)
  tax_amount      Decimal     @default(0)
  discount_amount Decimal     @default(0)
  shipping_cost   Decimal     @default(0)
  pdf_url         String?
  notes           String?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  organization Organization   @relation(fields: [organization_id], references: [id])
  supplier     Supplier       @relation(fields: [supplier_id], references: [id])
  items        PurchaseItem[]
  comments     POComment[]
}

model POComment {
  id                String   @id @default(uuid())
  purchase_order_id String
  user_id           String
  text              String
  created_at        DateTime @default(now())

  purchase_order PurchaseOrder @relation(fields: [purchase_order_id], references: [id])
  user           User          @relation(fields: [user_id], references: [id])
}

model PurchaseItem {
  id                 String  @id @default(uuid())
  purchase_order_id  String
  product_variant_id String
  quantity           Int
  unit_cost          Decimal
  received_quantity  Int     @default(0)

  purchase_order PurchaseOrder  @relation(fields: [purchase_order_id], references: [id])
  variant        ProductVariant @relation(fields: [product_variant_id], references: [id])
}

// Sales
model Customer {
  id              String   @id @default(uuid())
  organization_id String
  name            String
  email           String?
  phone           String?
  address         String?
  ltv             Decimal  @default(0)
  ranking         String? // Gold, Silver, Bronze
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])
  sales_orders SalesOrder[]
}

model SalesOrder {
  id              String        @id @default(uuid())
  organization_id String
  customer_id     String
  status          SalesStatus   @default(DRAFT)
  payment_status  PaymentStatus @default(PENDING)
  order_date      DateTime      @default(now())
  total_amount    Decimal       @default(0)
  profit          Decimal       @default(0)
  notes           String?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])
  customer     Customer     @relation(fields: [customer_id], references: [id])
  items        SalesItem[]
}

model SalesItem {
  id                 String  @id @default(uuid())
  sales_order_id     String
  product_variant_id String
  quantity           Int
  unit_price         Decimal

  sales_order SalesOrder     @relation(fields: [sales_order_id], references: [id])
  variant     ProductVariant @relation(fields: [product_variant_id], references: [id])
}

// System
model AuditLog {
  id              String   @id @default(uuid())
  organization_id String
  user_id         String
  action          String
  entity          String
  entity_id       String?
  details         Json? // Old/New values
  ip_address      String?
  user_agent      String?
  created_at      DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])
  user         User         @relation(fields: [user_id], references: [id])
}

model ApiKey {
  id              String    @id @default(uuid())
  organization_id String
  key             String    @unique
  name            String?
  rate_limit      Int       @default(100) // Requests per minute
  last_used_at    DateTime?
  created_at      DateTime  @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])
}

model UserDashboardConfig {
  id              String   @id @default(uuid())
  user_id         String
  organization_id String
  layout          Json // Stores the react-grid-layout configuration
  widgets         Json? // Stores widget-specific settings
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user         User         @relation(fields: [user_id], references: [id])
  organization Organization @relation(fields: [organization_id], references: [id])

  @@unique([user_id, organization_id])
}

model FeatureFlag {
  id              String   @id @default(uuid())
  organization_id String
  key             String
  is_enabled      Boolean  @default(false)
  description     String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, key])
}

model CustomField {
  id              String   @id @default(uuid())
  organization_id String
  entity_type     String // PRODUCT, ORDER, CUSTOMER
  name            String
  type            String // TEXT, NUMBER, DATE, BOOLEAN
  is_required     Boolean  @default(false)
  created_at      DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])
}

model AutomationRule {
  id              String   @id @default(uuid())
  organization_id String
  name            String
  trigger_event   String // ORDER_CREATED, LOW_STOCK
  action_type     String // SEND_EMAIL, CREATE_TASK
  action_config   Json // { "recipient": "admin@example.com" }
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])
}

model Location {
  id           String   @id @default(uuid())
  warehouse_id String
  name         String // e.g., "Aisle 1", "Rack B"
  code         String // e.g., "A1-RB-S2"
  type         String // AISLE, RACK, SHELF, BIN
  parent_id    String?
  capacity     Int?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  warehouse Warehouse  @relation(fields: [warehouse_id], references: [id])
  parent    Location?  @relation("LocationHierarchy", fields: [parent_id], references: [id])
  children  Location[] @relation("LocationHierarchy")
}

model InventoryAudit {
  id              String    @id @default(uuid())
  organization_id String
  warehouse_id    String
  status          String // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  started_at      DateTime?
  completed_at    DateTime?
  notes           String?
  created_by      String // User ID
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouse_id], references: [id])
  items        AuditItem[]
}

model AuditItem {
  id                 String    @id @default(uuid())
  audit_id           String
  product_variant_id String
  expected_quantity  Int
  counted_quantity   Int?
  discrepancy        Int? // counted - expected
  notes              String?
  counted_at         DateTime?

  audit   InventoryAudit @relation(fields: [audit_id], references: [id])
  variant ProductVariant @relation(fields: [product_variant_id], references: [id])
}

model IntegrationConfig {
  id              String   @id @default(uuid())
  organization_id String
  platform        String // SHOPIFY, WOOCOMMERCE
  api_url         String?
  api_key         String?
  api_secret      String? // Encrypt this in app logic
  access_token    String?
  is_active       Boolean  @default(true)
  settings        Json? // Sync preferences
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])
}

model ExternalMapping {
  id              String   @id @default(uuid())
  organization_id String
  entity_type     String // PRODUCT, VARIANT, ORDER, CUSTOMER
  local_id        String
  external_id     String
  platform        String // SHOPIFY, WOOCOMMERCE
  last_synced_at  DateTime @default(now())

  @@unique([organization_id, entity_type, local_id, platform])
}

model WebhookSubscription {
  id              String   @id @default(uuid())
  organization_id String
  url             String
  events          String[] // ["inventory.updated", "order.created"]
  secret          String? // For signature verification
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])
}
