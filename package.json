{
  "name": "saas-inventory-system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/server\" \"npm run dev --workspace=apps/client\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "setup": "npm install && npx prisma generate --schema=apps/server/prisma/schema.prisma && npx prisma migrate dev --schema=apps/server/prisma/schema.prisma"
  },
  "devDependencies": {
    "@prisma/client": "^5.10.0",
    "concurrently": "^8.2.2",
    "prisma": "^5.10.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.86.0",
    "pg": "^8.16.3"
  }
}
